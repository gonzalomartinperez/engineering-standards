{
  "$schema": "https://raw.githubusercontent.com/gonzalomartinperez/engineering-standards/main/schemas/ci-profile.schema.json",
  "$comment": "Example map for a Next.js web repository. Every tracked file must match a profile (a unit test should assert it); otherwise classify runs everything.",
  "version": 1,
  "base": ["docs", "security"],
  "profiles": {
    "docs": {
      "paths": ["**/*.md", "docs/**", "LICENSE"],
      "adds": [],
      "budgetP50Minutes": 2,
      "budgetP95Minutes": 4
    },
    "code": {
      "paths": ["src/**", "app/**", "public/**", "tests/**", "package.json", "package-lock.json", "tsconfig*.json", "biome.json", "next.config.*", ".nvmrc", ".gitignore", "standards.lock"],
      "adds": ["lint", "test", "build"],
      "budgetP50Minutes": 5,
      "budgetP95Minutes": 10
    },
    "contract": {
      "paths": ["contracts/**"],
      "adds": ["lint", "test", "contract"],
      "budgetP50Minutes": 7,
      "budgetP95Minutes": 12
    },
    "workflow": {
      "paths": [".github/**"],
      "adds": ["lint", "test"],
      "budgetP50Minutes": 3,
      "budgetP95Minutes": 6
    },
    "harness": {
      "paths": [".agents/**", ".claude/**", ".codex/**", "AGENTS.md", "CLAUDE.md", ".mcp.json"],
      "adds": ["check-skills"],
      "budgetP50Minutes": 3,
      "budgetP95Minutes": 6
    },
    "deps-weekly": {
      "trigger": "branch dependabot/** or label deps-weekly (built-in)",
      "adds": ["all-profiles"],
      "budgetP50Minutes": 8,
      "budgetP95Minutes": 13
    },
    "release": {
      "trigger": "develop -> main or label release (built-in)",
      "adds": ["full-matrix", "lighthouse"],
      "budgetP50Minutes": 10,
      "budgetP95Minutes": 20
    },
    "hotfix": {
      "trigger": "hotfix/** -> main (built-in)",
      "adds": ["release-verify"],
      "budgetP50Minutes": 5,
      "budgetP95Minutes": 10
    }
  },
  "required": "ci-gate"
}
