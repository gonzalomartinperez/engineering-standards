{
  "$schema": "../schemas/ci-profile.schema.json",
  "$comment": "CI profile map of engineering-standards itself (ecosystem 6.0). Fail closed: any file outside every profile runs everything.",
  "version": 1,
  "base": ["docs"],
  "profiles": {
    "docs": {
      "paths": ["**/*.md", "docs/**", "LICENSE"],
      "adds": [],
      "budgetP50Minutes": 2,
      "budgetP95Minutes": 4
    },
    "code": {
      "paths": [
        "tools/**", "tests/**", "scripts/**", "rulesets/**", "harness/**", "templates/**", "schemas/**",
        "standard/**", "progress/**", "tokens/**", "eval-tooling/**", "VERSION", ".gitignore",
        ".yamllint.yml", ".markdownlint-cli2.jsonc"
      ],
      "adds": ["lint", "test", "security"],
      "budgetP50Minutes": 3,
      "budgetP95Minutes": 6
    },
    "workflow": {
      "paths": [".github/**", "actions/**"],
      "adds": ["lint", "test", "security", "self-test"],
      "budgetP50Minutes": 4,
      "budgetP95Minutes": 8
    },
    "deps-weekly": {
      "trigger": "branch dependabot/** or label deps-weekly",
      "adds": ["all-profiles"],
      "budgetP50Minutes": 6,
      "budgetP95Minutes": 10
    }
  },
  "required": "ci-gate"
}
