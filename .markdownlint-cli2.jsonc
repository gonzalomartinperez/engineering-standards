{
  // Prose lines are not wrapped; tables and long links are allowed.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": { "allowed_elements": ["div", "img", "h1", "p", "a", "picture", "source", "br", "details", "summary"] },
    "MD041": false,
    "MD024": { "siblings_only": true }
  },
  // standard/ holds byte-identical canonical copies maintained through the standards process.
  "ignores": ["standard/**", "node_modules/**", ".venv/**", "CODE_OF_CONDUCT.md", "templates/community/CODE_OF_CONDUCT.md"]
}
